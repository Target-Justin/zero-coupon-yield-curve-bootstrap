# =========================================================
# Python / editor
# =========================================================
__pycache__/
*.py[cod]
.venv/
.vscode/

# =========================================================
# Bloomberg data: NOT publishable (raw + anything derived)
# =========================================================

# 1. Raw Bloomberg exports (the .gitkeep files keep the folder structure)
data/raw/ois/*/*.csv
*.xlsx
*.xls
*.xlsm

# 2. Transformed data built from the quotes
data/processed/ois/

# 3. Every OIS result: CSV (cash flows, discount factors, zero rates,
#    QuantLib benchmark, gathered zero_rate.csv) and every plot
#    (curves, comparisons, spreads), since they allow recovering the points
results/ois/

# 4. Safety net: any file named after an OIS curve, wherever it lands
*estr*
*sofr*
*ESTR*
*SOFR*

# Exceptions to the safety net: code, docs, and the ESTR/SOFR folders
# themselves (so that data/raw/ois/ESTR/.gitkeep stays tracked; the CSV
# files inside are still ignored by rule 1)
!*.py
!*.md
!*estr*/
!*sofr*/
!*ESTR*/
!*SOFR*/